# Test debris. recovery.js parks the file it breaks here so an interrupted run
# can be healed by the next one, and screenshots the safe-mode notice.
tests/watchdog/.victim-backup
tests/watchdog/watchdog-notice.png
tests/**/shots/
.verify.lock

# The gate-7 schema check writes its transcript here so a Playground run,
# which only prints a step that failed, can still be read.
tests/librarian/gate7-last-run.txt

# Plugin Check leaves a full-page screenshot of the result it read.
tools/.plugin-check.png

# The AI folders suite writes its transcript here, for the same reason the
# gate-7 one does: a passing Playground step prints nothing.
tests/tree/ai-folders-last-run.txt

tests/tree/auto-file-last-run.txt

tests/tree/nl-commands-last-run.txt

tests/tree/quarantine-last-run.txt
