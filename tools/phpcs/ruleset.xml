<?xml version="1.0"?>
<ruleset name="VergeML review">
	<description>The WordPress Coding Standards sniffs a wordpress.org plugin reviewer reads.</description>

	<config name="minimum_wp_version" value="6.5"/>

	<rule ref="WordPress.Security"/>
	<rule ref="WordPress.WP.EnqueuedResources"/>
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="vergelabs-media-library"/>
			</property>
		</properties>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="vergeml"/>
				<element value="vergelabs"/>
			</property>
		</properties>
	</rule>
	<rule ref="WordPress.DB.PreparedSQL"/>
	<rule ref="WordPress.DB.PreparedSQLPlaceholders"/>
</ruleset>
